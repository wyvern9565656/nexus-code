<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Nexus Light</string>
  <key>author</key>
  <string>Nexus Code</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#FFFFFF</string>
        <key>foreground</key><string>#232629</string>
        <key>caret</key><string>#232629</string>
        <key>selection</key><string>#CFE8FF</string>
        <key>lineHighlight</key><string>#F4F8FC</string>
        <key>invisibles</key><string>#C7CCD2</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment</string>
      <key>settings</key><dict><key>foreground</key><string>#8A8F94</string><key>fontStyle</key><string>italic</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, keyword.control, keyword.operator, storage.modifier</string>
      <key>settings</key><dict><key>foreground</key><string>#0057AE</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Type</string>
      <key>scope</key><string>storage.type, support.type, entity.name.type</string>
      <key>settings</key><dict><key>foreground</key><string>#0057AE</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, support.function</string>
      <key>settings</key><dict><key>foreground</key><string>#7A3E9D</string></dict>
    </dict>
    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, string.quoted</string>
      <key>settings</key><dict><key>foreground</key><string>#BF0303</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Number and constant</string>
      <key>scope</key><string>constant.numeric, constant.language, constant.character</string>
      <key>settings</key><dict><key>foreground</key><string>#B08000</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Attribute</string>
      <key>scope</key><string>meta.attribute</string>
      <key>settings</key><dict><key>foreground</key><string>#B08000</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Punctuation</string>
      <key>scope</key><string>punctuation</string>
      <key>settings</key><dict><key>foreground</key><string>#6C737A</string></dict>
    </dict>
  </array>
</dict>
</plist>
